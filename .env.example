ANTHROPIC_API_KEY=

# Embedding provider: "ollama" (default) or "voyage"
# EMBEDDING_PROVIDER=ollama

# --- Ollama (default) ---
# Requires Ollama running locally: https://ollama.com
# Pull the model first: ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text

# --- Voyage (set EMBEDDING_PROVIDER=voyage) ---
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-code-3

# Optional overrides
ANTHROPIC_MODEL=claude-haiku-4-5
ASK_THE_REPO_TOP_K=12
ASK_THE_REPO_MAX_TOKENS=1024

# Centralized index location (defaults to ~/.ask-the-repo/indexes/)
# ASK_THE_REPO_INDEX_BASE=

# Admin UI (served on `serve` command)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# ADMIN_PORT=3000

# Slack bot (required for `serve` command)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Git provider auth ---
# Option 1: Personal access token
# GITHUB_TOKEN=
# BITBUCKET_TOKEN=

# Option 2: GitHub App (alternative to GITHUB_TOKEN)
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=          # PEM string, base64-encoded PEM, or path to .pem file

# --- PostgreSQL storage (for container deployments) ---
# When set, indexes and repo registry are stored in PostgreSQL instead of the filesystem.
# Requires PostgreSQL with the pgvector extension (available on AWS RDS / Aurora PostgreSQL).
# DATABASE_URL=postgres://user:password@host:5432/askrepos
