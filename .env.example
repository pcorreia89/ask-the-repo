ANTHROPIC_API_KEY=

# --- LLM provider: "anthropic" (default) or "bedrock" ---
# Set LLM_PROVIDER=bedrock to route Claude requests through AWS Bedrock
# using IAM credentials instead of an Anthropic API key. ANTHROPIC_API_KEY
# is then ignored and may be left blank.
# LLM_PROVIDER=bedrock

# Bedrock model identifier — either a foundation model id or an inference
# profile ARN. Required when LLM_PROVIDER=bedrock.
# BEDROCK_MODEL_ID=arn:aws:bedrock:<region>:<account-id>:inference-profile/<profile-id>

# Standard AWS SDK env vars resolve region and credentials automatically:
# AWS_REGION=eu-west-1
# AWS_PROFILE=<profile-name>          # local dev

# In ECS/EKS/EC2 the SDK picks up the task / instance role — no creds needed.
# IAM permissions required: bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream
# on the chosen model ARN.

# Embedding provider: "ollama" (default) or "voyage"
# EMBEDDING_PROVIDER=ollama

# --- Ollama (default) ---
# Requires Ollama running locally: https://ollama.com
# Pull the model first: ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text

# --- Voyage (set EMBEDDING_PROVIDER=voyage) ---
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-code-3

# Optional overrides
ANTHROPIC_MODEL=claude-haiku-4-5
ASK_THE_REPO_TOP_K=12
ASK_THE_REPO_MAX_TOKENS=1024

# Centralized index location (defaults to ~/.ask-the-repo/indexes/)
# ASK_THE_REPO_INDEX_BASE=

# Admin UI (served on `serve` command)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# ADMIN_PORT=3000

# Slack bot (required for `serve` command)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Git provider auth ---
# Option 1: Personal access token
# GITHUB_TOKEN=
# BITBUCKET_TOKEN=

# Option 2: GitHub App (alternative to GITHUB_TOKEN)
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=          # PEM string, base64-encoded PEM, or path to .pem file

# --- PostgreSQL storage (for container deployments) ---
# When set, indexes and repo registry are stored in PostgreSQL instead of the filesystem.
# Requires PostgreSQL with the pgvector extension (available on AWS RDS / Aurora PostgreSQL).
# DATABASE_URL=postgres://user:password@host:5432/ask-the-repo
